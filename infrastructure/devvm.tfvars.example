ssh_public_keys = ["ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY"]
# Add additional host keys as separate list entries; the guest authorizes all of them.
# Set to the private key matching one ssh_public_keys entry to avoid agent fallback.
# ssh_identity_file = "~/.ssh/id_ed25519"
repository_path = ".." # Relative to infrastructure/
dotfiles_path   = "~/.dotfiles"

# Dedicated pool default: /var/lib/libvirt/images/<VM name>-user. Its
# directory is owned by the OpenTofu user and group-accessible to QEMU.
# Override these IDs for your host; find them with `id -u` and `id libvirt-qemu`.
# storage_owner_uid = 1000
# disk_permissions = { gid = 64055 }
# vm_storage_pool_name = "devvm-user"
# vm_storage_pool_path = "/var/lib/libvirt/images/devvm-user"

# Defaults for Ubuntu's ovmf package. Override for another distribution.
# uefi = {
#   code          = "/usr/share/OVMF/OVMF_CODE_4M.fd"
#   vars_template = "/usr/share/OVMF/OVMF_VARS_4M.fd"
# }

guest = {
  username = "gigid"
  uid      = 1000
  gid      = 1000
  hostname = "devvm"
  timezone = "Europe/Bucharest"
}

# Configure the export separately on Ubuntu. Match the host UID/GID above.
# nfs_mounts = [{
#   server = "192.168.122.1"
#   export = "/srv/dev"
#   mountpoint = "/mnt/host-dev"
# }]

# All functions must already be isolated and bound to vfio-pci on the host.
# gpu = {
#   enabled       = true
#   pci_functions = ["0000:01:00.0", "0000:01:00.1"]
#   open_driver   = true # Turing or newer; check your specific GPU
# }
# streaming = { enabled = true, encoder = "nvenc", autologin = true }
# toolchains = { python = true, node = true, llvm = true, rust = true }
