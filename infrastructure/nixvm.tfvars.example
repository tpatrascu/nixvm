# The filename stem (`nixvm`) becomes the VM name, guest hostname, and state workspace.
vcpu       = 4
memory_mib = 8192 # MiB
disk_gib   = 80   # GiB

ssh_public_keys = ["ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY"]
# Add additional host keys as separate list entries; the guest authorizes all of them.
# Set to the private key matching one ssh_public_keys entry to avoid agent fallback.
# ssh_identity_file = "~/.ssh/id_ed25519"
repository_path = ".." # Relative to infrastructure/
dotfiles_path   = "~/.dotfiles"

# Guest-initiated host access. The dedicated VM NAT gateway is included
# automatically; these IPs add other host addresses. Configure TCP and UDP
# ports separately.
# the managed mitmproxy is separately allowed on gateway TCP/8080.
# Host firewall integration: "disabled" leaves host rules unchanged; "ufw"
# adds persistent rules for gateway DNS, enabled mitmproxy, and host NFS exports.
# host_firewall = "ufw"
# host_access = {
#   ips       = []
#   tcp_ports = [53, 2049]
#   udp_ports = [53]
#   all_ports = false
# }

# mitmproxy runs as a Podman container under the host user's systemd. `up`
# pulls the configured image on every run; `latest` tracks the current stable
# mitmproxy release. Domains include their subdomains. An empty inspect list
# passes HTTPS through without TLS decryption.
# mitmproxy_enabled = true # default: false; false enables direct web egress
# mitm_proxy_blocked_http_ports = [80, 443, 8443, 8080, 8081, 8082]
# mitmproxy_policy = {
#   image           = "docker.io/mitmproxy/mitmproxy:latest"
#   inspect_domains = ["api.example.com", "updates.example.net"]
#   blocked_domains = ["telemetry.example.org"]
#   allowed_domains = ["glob:trusted-*.example.org", "regex:api[0-9]+\\.example\\.net"]
#   # Proxy-only exception for an internal TLS service. Direct guest access
#   # remains blocked by internal_network_deny.
#   allowed_internal_hosts = [
#     { hostname = "git.internal.example", ips = ["192.168.50.10"], ports = [443] },
#   ]
# }

# The firewall test subnet is managed on the VM's NAT bridge and removed by
# `nixvm destroy`. Choose a non-overlapping IPv4 subnet whose gateway remains
# covered by internal_network_deny.
# firewall_test_network_cidr = "192.168.123.0/24"
# vm_network_cidr = "192.168.124.0/24"
# Guest-initiated access to the standard internal CIDRs is denied by default.
# Leave internal_network_deny unset to keep those defaults. If overriding that
# list, include any standard CIDRs you still want denied.
# internal_network_deny = ["10.0.0.0/8", "10.10.0.0/16"]
# Per-IP access rules are independent and preserve the default deny list.
# internal_network_allow = [
#   { ip = "10.0.0.25", tcp_ports = [443], udp_ports = [], all_ports = false },
#   { ip = "10.0.0.26", tcp_ports = [], udp_ports = [], all_ports = true }, # still blocks managed web ports
# ]

# Manually configured NFS exports on other servers mounted in the guest.
# nfs_mounts = [{
#   server = "192.0.2.10"
#   export = "/exports/shared"
#   mountpoint = "/mnt/host-dev"
# }]
# Host paths mounted by the guest over NFS. The setup command creates the host
# export entries and installs the NFS server package if needed. `./nixvm up`
# runs this setup after confirmation.
# Make sure you allow port 2049 in "host_access".
# host_nfs_exports = [{
#   host_path = "/srv/dev"
#   guest_path = "/mnt/host-dev"
# }]


# Dedicated pool default: /var/lib/libvirt/images/<VM name>-user. Its
# directory is owned by the OpenTofu user and group-accessible to QEMU.
# Override these IDs for your host; find them with `id -u` and `id libvirt-qemu`.
# storage_owner_uid = 1000
# disk_permissions = { gid = 64055 }
# vm_storage_pool_name = "nixvm-user"
# vm_storage_pool_path = "/var/lib/libvirt/images/nixvm-user"

# Defaults for Ubuntu's ovmf package. Override for another distribution.
# uefi = {
#   code          = "/usr/share/OVMF/OVMF_CODE_4M.fd"
#   vars_template = "/usr/share/OVMF/OVMF_VARS_4M.fd"
# }

guest = {
  username = "gigid"
  uid      = 1000
  gid      = 1000
  timezone = "Europe/Bucharest"
}

# All functions must already be isolated and bound to vfio-pci on the host.
# gpu = {
#   enabled       = true
#   pci_functions = ["0000:01:00.0", "0000:01:00.1"]
#   open_driver   = true # Turing or newer; check your specific GPU
# }
# streaming = { enabled = true, encoder = "nvenc", autologin = true }

# Development toolchains and applications are disabled by default; opt into
# only the ones this VM needs. Platform-unavailable applications are skipped.
# toolchains = { python = true, node = true, llvm = true, rust = true, jdk = true, garmin = true, tcc = true }
# Additional Nixpkgs package attribute paths, including nested paths.
# additional_nix_pkgs = ["ripgrep", "fd", "python3Packages.pip"]
# apps = {
#   editors      = { zed = true, vscode = true }
#   terminals    = { kitty = true, ghostty = true }
#   browsers     = { firefox = true, chromium = false }
#   coding_agents = { omp = true, codex = true, chatgpt = true, claudeCode = true, opencode = true }
# }
# default_editor   = "nvim" # or "zed" / "vscode"; selected GUI editor is enabled and pinned
# default_terminal = "kitty" # or "ghostty"; selecting it enables and pins it
# default_shell    = "zsh" # or "bash"
# default_browser  = "firefox" # or "chromium"; selecting it enables and pins it
# default_coding_agent = "none" # or "omp", "codex", "chatgpt", "claudeCode", "opencode"; enables and pins the selected agent
