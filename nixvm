#!/usr/bin/env python3
"""User-facing commands for the local NixOS VM workflow."""

import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys


ROOT = Path(__file__).resolve().parent
INFRA = ROOT / "infrastructure"
INTERNAL = ROOT / "scripts" / "nixvm.py"


def usage():
    print("""Usage: nixvm [-n|--name VM] <command> [options]

VM lifecycle:
  up | apply [tofu options]  Prepare host NFS/proxy, apply VM, activate proxy policy, test firewall
  u [tofu options]           Apply infrastructure, then activate host NixOS config
  init [tofu options]        Initialize OpenTofu
  plan [tofu options]        Run tofu plan
  destroy [tofu options]     Destroy VM, clear its SSH host key; retain host NFS exports
  preflight [var options]    Check host tools, libvirt, and VM settings
  s | start [options]        Start the VM
  stop [options]             Gracefully stop the VM
  ssh [guest command...]     Open a guest shell or run a guest command
  spice [viewer options...]  Open the SPICE console with automatic guest resizing
  ip                         Print the VM's current IPv4 address
  rebuild | rollback         Rebuild or roll back the guest system
  update-config              Activate this host checkout's NixOS config in the guest
  reboot | password          Reboot the guest or change its password
  reprovision [tofu options] Retry OpenTofu bootstrap

Host setup:
  nfs setup [var options]    Confirm and configure host NFS exports
  nfs cleanup [var options]  Confirm removal of this VM's managed exports
  mitmproxy password         Print the selected VM's mitmweb UI password
  image remove              Remove this VM's image and workstation build cache
  firewall-test [var options] Check the managed firewall network and policy

VM name defaults to nixvm. The matching infrastructure/<name>.tfvars file is
used when it exists. Pass -var-file=PATH or set NIXVM_VAR_FILE to choose another.""")


def run(command, *, env=None, capture=False):
    return subprocess.run(command, cwd=ROOT, check=True, env=env, text=True,
                          stdout=subprocess.PIPE if capture else None)


def valid_vm_name(name):
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,30}", name):
        raise ValueError("VM names must be lowercase letters, digits, and hyphens, starting with a letter.")
    return name


def extract_name(arguments):
    name = "nixvm"
    remaining = []
    index = 0
    while index < len(arguments):
        arg = arguments[index]
        if arg in ("-n", "--name"):
            if index + 1 >= len(arguments):
                raise ValueError(f"{arg} requires a VM name")
            name = arguments[index + 1]
            index += 2
        elif arg.startswith("--name="):
            name = arg.split("=", 1)[1]
            index += 1
        else:
            remaining.append(arg)
            index += 1
    return valid_vm_name(name), remaining


def ensure_workspace(name):
    env = os.environ.copy()
    env.pop("TF_WORKSPACE", None)
    listing = run(["tofu", f"-chdir={INFRA}", "workspace", "list"], env=env, capture=True)
    workspaces = {line.strip().lstrip("*").strip() for line in listing.stdout.splitlines()}
    if name in workspaces:
        run(["tofu", f"-chdir={INFRA}", "workspace", "select", name], env=env)
    else:
        args = ["tofu", f"-chdir={INFRA}", "workspace", "new"]
        args.append(name)
        run(args, env=env)
    os.environ["TF_WORKSPACE"] = name
    os.environ["NIXVM_PROFILE"] = name


def split_arguments(arguments, name="nixvm"):
    """Separate OpenTofu variable flags from operation-specific flags."""
    variables = []
    operation = []
    index = 0
    explicit_file = False
    while index < len(arguments):
        argument = arguments[index]
        if argument == "-var-file":
            if index + 1 >= len(arguments):
                raise ValueError("-var-file requires a path")
            value = arguments[index + 1]
            variables.append(f"-var-file={resolve_var_file(value)}")
            explicit_file = True
            index += 2
        elif argument.startswith("-var-file="):
            variables.append(f"-var-file={resolve_var_file(argument.split('=', 1)[1])}")
            explicit_file = True
            index += 1
        elif argument == "-var":
            if index + 1 >= len(arguments):
                raise ValueError("-var requires a value")
            variables.append(f"-var={arguments[index + 1]}")
            index += 2
        elif argument.startswith("-var="):
            variables.append(argument)
            index += 1
        else:
            operation.append(argument)
            index += 1

    if not explicit_file:
        configured = os.environ.get("NIXVM_VAR_FILE")
        default = resolve_var_file(configured) if configured else INFRA / f"{name}.tfvars"
        if default.is_file():
            variables.insert(0, f"-var-file={default}")
    variables.append(f"-var=name={name}")
    return variables, operation


def resolve_var_file(value):
    path = Path(value).expanduser()
    if not path.is_absolute():
        under_infra = INFRA / path
        path = under_infra if under_infra.exists() else ROOT / path
    return path.resolve()


def tofu(command, arguments):
    run(["tofu", f"-chdir={INFRA}", command, *arguments])


def current_vm_name():
    result = subprocess.run(
        ["tofu", f"-chdir={INFRA}", "output", "-json", "connection"],
        cwd=ROOT, check=False, text=True, stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    if result.returncode:
        return None
    try:
        name = json.loads(result.stdout)["name"]
    except (json.JSONDecodeError, KeyError, TypeError):
        return None
    if isinstance(name, str) and re.fullmatch(r"[a-z][a-z0-9-]{0,30}", name):
        return name
    return None


def internal(command, arguments=()):
    run([sys.executable, str(INTERNAL), command, *arguments])


def desktop_exec_arg(value):
    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
    escaped = escaped.replace("`", "\\`").replace("$", "\\$")
    return f'"{escaped}"'


def install_spice_shortcut(vm_name):
    # Use the viewer directly so the launcher does not depend on GNOME inheriting
    # the interactive shell's PATH for nixvm's OpenTofu lookup.
    viewer = shutil.which("virt-viewer") or "virt-viewer"
    entry = "\n".join([
        "[Desktop Entry]",
        "Type=Application",
        f"Name=NixVM SPICE ({vm_name})",
        "Comment=Open the NixVM console with automatic resolution resizing",
        f"Exec={desktop_exec_arg(viewer)} --auto-resize=always -c qemu:///system --domain-name {desktop_exec_arg(vm_name)}",
        f"TryExec={viewer}",
        "Icon=computer",
        "Terminal=false",
        "Categories=Utility;",
        f"Keywords=nixvm-spice;{vm_name};spice;virt-viewer;console;",
        "StartupWMClass=virt-viewer",
        "StartupNotify=true",
        "",
    ])
    data_homes = [Path.home() / ".local/share"]
    configured_data_home = os.environ.get("XDG_DATA_HOME")
    if configured_data_home:
        configured_data_home = Path(configured_data_home).expanduser()
        if configured_data_home.is_absolute() and configured_data_home not in data_homes:
            data_homes.append(configured_data_home)
    for data_home in data_homes:
        applications = data_home / "applications"
        applications.mkdir(parents=True, exist_ok=True)
        launcher = applications / f"nixvm-spice-{vm_name}.desktop"
        if not launcher.exists() or launcher.read_text(encoding="utf-8") != entry:
            launcher.write_text(entry, encoding="utf-8")
        launcher.chmod(0o644)
        update_db = shutil.which("update-desktop-database")
        if update_db:
            subprocess.run([update_db, str(applications)], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, check=False)

    desktop_path = Path.home() / "Desktop"
    xdg_user_dir = shutil.which("xdg-user-dir")
    if xdg_user_dir:
        result = subprocess.run([xdg_user_dir, "DESKTOP"], check=False,
                                capture_output=True, text=True)
        if result.returncode == 0 and result.stdout.strip():
            desktop_path = Path(result.stdout.strip()).expanduser()
    desktop = desktop_path
    if desktop.is_dir():
        shortcut = desktop / f"nixvm-spice-{vm_name}.desktop"
        if not shortcut.exists() or shortcut.read_text(encoding="utf-8") != entry:
            shortcut.write_text(entry, encoding="utf-8")
        shortcut.chmod(0o755)
        gio = shutil.which("gio")
        if gio:
            subprocess.run([gio, "set", str(shortcut), "metadata::trusted", "true"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def firewall_tests(variables):
    internal("firewall-test", variables)


def main(arguments):
    if not arguments:
        usage()
        return 0

    name, arguments = extract_name(arguments)
    if not arguments or arguments[0] in ("-h", "--help", "help"):
        usage()
        return 0
    command, *extra = arguments
    commands = {"up", "apply", "u", "init", "plan", "destroy", "preflight", "firewall-test",
                "nfs", "mitmproxy", "image", "reprovision", "ssh", "ip", "start", "s", "stop", "rebuild",
                "rollback", "reboot", "password", "forward", "usb-attach", "usb-detach",
                "gpu-check", "token-check", "import-public-keys", "update-config", "spice"}
    if command not in commands:
        raise ValueError(f"Unknown command: {command}. Run 'nixvm help' for usage.")
    profile = name
    os.environ["TF_WORKSPACE"] = profile
    os.environ["NIXVM_PROFILE"] = profile
    if command == "init":
        pass
    elif command != "mitmproxy":
        ensure_workspace(profile)
    if command in ("up", "apply", "u"):
        variables, operation = split_arguments(extra, profile)
        internal("setup-host-nfs", variables)
        internal("check-host-nfs", variables)
        internal("define-network-filter", variables)
        internal("ensure-vm-nat", variables)
        internal("setup-host-mitmproxy", variables)
        apply_args = [*variables, *operation]
        if "-auto-approve" not in apply_args:
            apply_args.append("-auto-approve")
        tofu("apply", apply_args)
        internal("update-config", variables)
        firewall_tests(variables)
        internal("setup-hostname")
        install_spice_shortcut(current_vm_name() or profile)
    elif command == "init":
        _, operation = split_arguments(extra, profile)
        env = os.environ.copy()
        env.pop("TF_WORKSPACE", None)
        run(["tofu", f"-chdir={INFRA}", "init", *operation], env=env)
        ensure_workspace(profile)
    elif command == "plan":
        variables, operation = split_arguments(extra, profile)
        tofu("plan", [*variables, *operation])
    elif command == "destroy":
        variables, operation = split_arguments(extra, profile)
        vm_name = current_vm_name()
        tofu("destroy", [*variables, *operation])
        if vm_name:
            # Keep .build/<profile> and its Nix closure for reuse if recreated.
            (ROOT / ".runtime" / vm_name / "known_hosts").unlink(missing_ok=True)
            internal("cleanup-hostname", ["--name", vm_name])
    elif command == "preflight":
        variables, operation = split_arguments(extra, profile)
        if operation:
            raise ValueError("nixvm preflight accepts only -var-file and -var options")
        internal("preflight", variables)
    elif command == "firewall-test":
        variables, operation = split_arguments(extra, profile)
        if operation:
            raise ValueError("nixvm firewall-test accepts only -var-file and -var options")
        firewall_tests(variables)
    elif command == "nfs":
        if not extra or extra[0] not in ("setup", "cleanup"):
            raise ValueError("Use 'nixvm nfs setup' or 'nixvm nfs cleanup'")
        action, *options = extra
        variables, operation = split_arguments(options, profile)
        if operation:
            raise ValueError("nixvm nfs accepts only -var-file and -var options")
        if action == "cleanup":
            if any("host_nfs_exports=" in arg for arg in variables):
                raise ValueError("Do not override host_nfs_exports when using 'nixvm nfs cleanup'")
            variables.append("-var=host_nfs_exports=[]")
        internal("setup-host-nfs", variables)
    elif command == "image":
        if len(extra) != 1 or extra[0] != "remove":
            raise ValueError("Use 'nixvm [-n NAME] image remove'")
        internal("remove-image", ["--name", profile])
    elif command == "mitmproxy":
        if not extra or extra[0] != "password":
            raise ValueError("Use 'nixvm mitmproxy password [-var-file=PATH]'")
        _, operation = split_arguments(extra[1:], profile)
        if operation:
            raise ValueError("nixvm mitmproxy password accepts only -var-file and -var options")
        password_file = (Path.home() / ".local" / "share" / "nixvm" / "shared"
                         / "mitmproxy" / "web_password")
        if not password_file.is_file():
            raise FileNotFoundError(
                f"mitmproxy password not found at {password_file}; run 'nixvm up' first"
            )
        print(password_file.read_text(encoding="utf-8").strip())
    elif command == "reprovision":
        variables, operation = split_arguments(extra, profile)
        internal("setup-host-nfs", variables)
        internal("check-host-nfs", variables)
        internal("define-network-filter", variables)
        internal("ensure-vm-nat", variables)
        internal("setup-host-mitmproxy", variables)
        tofu("apply", [*variables, "-replace=terraform_data.bootstrap", *operation])
        internal("update-config", variables)
    elif command == "update-config":
        variables, operation = split_arguments(extra, profile)
        if operation:
            raise ValueError("nixvm update-config accepts only -var-file and -var options")
        internal("update-config", variables)
    elif command in {"ssh", "ip", "start", "s", "stop", "rebuild", "rollback", "reboot",
                     "password", "forward", "usb-attach", "usb-detach", "gpu-check",
                     "token-check", "import-public-keys", "spice"}:
        internal("start" if command == "s" else command, extra)
    else:
        raise ValueError(f"Unknown command: {command}. Run 'nixvm help' for usage.")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except (ValueError, subprocess.CalledProcessError) as error:
        print(error, file=sys.stderr)
        raise SystemExit(getattr(error, "returncode", 2) or 2)
    except KeyboardInterrupt:
        raise SystemExit(130)
